<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Listagem Empresas</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="/php/assets/css/listagem_index.css">
</head>
<body class="container-fluid">
  <table class="table table-striped table-bordered">
    <thead class="text-center sticky-top align-middle">
      <tr class="bg-white border-none">
        <th colspan="9" class="p-0 -m-0 bg-white ">
          <h1 class="py-2 m-0 display-5 text-center bg-success text-light">
            Empresas Cadastradas
            <div class="excel-icon">
              <a href="./empresas/xlsx" title="Baixar"> 
                <svg width="20" height="20" stroke="rgb(25, 135, 84)" class="bi bi-file-earmark-excel" viewBox="0 0 16 16">
                  <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"/>
                  <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z"/>
                </svg>
              </a>
            </div>
          </h1>
        </th>
      </tr>
      <tr class="">
        <th>CNPJ</th>
        <th>RAZÃO SOCIAL</th>
        <th>UF</th>
        <th>INSCRIÇÃO ESTADUAL</th>
        <th>MUNICÍPIO</th>
        <th>INSCRIÇÃO MUNICIPAL</th>
        <th>REGIME TRIBUTÁRIO</th>
        <th>STATUS DOMÍNIO</th>
      </tr>
    </thead>
    <tbody class="text-center align-middle">
    {% for empresa in empresas %}
      <tr>
        <td>{{ empresa.cnpj }}</td>
        <td class="text-left">{{ empresa.razao_social }}</td>
        <td>{{ empresa.estado }}</td>
        <td>{{ empresa.insc_estadual }}</td>
        <td>{{ empresa.municipio }}</td>
        <td>{{ empresa.insc_municipal }}</td>
        <td>{{ empresa.regime }}</td>
        <td>
          {% if empresa.status_dominio == "ATIVA" %}
              <span class="badge bg-success">{{ empresa.status_dominio }}</span>
          {% elseif empresa.status_dominio == "INATIVA" %}
              <span class="badge bg-danger">
                {{ empresa.tipo_inatividade }}
                <br>
                ({{ empresa.data_inatividade }})
              </span>
          {% else %}
              <div class="badge bg-secondary">
                <span class="d-block">ATIVA</span>
                <span>SEM MOVIMENTO</span>
              </div>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
  </tbody>
  </table>
</body>
</html>